# Paste a fresh MongoDB Atlas connection string here after replacing the exposed password.
MONGODB_URI=mongodb+srv://<database-user>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DATABASE=shopease
PORT=3000
# Generate a long, random value. Never expose it in frontend code or commit backend/.env.
ADMIN_API_KEY=replace-with-a-long-random-secret
